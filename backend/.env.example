# ==============================================================================
# 🌟 KAGEWIRE ENTERPRISE BACKEND CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 💻 SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Active port the server listens on
PORT=3000

# Application execution environment [development | production | staging | test]
NODE_ENV=development

# API path version prefix for versioning endpoints
API_PREFIX=/api/v1

# Allowed Frontend Origin URL (used to configure CORS dynamically)
CLIENT_URL=

# Allowed CORS HTTP methods (comma-separated list)
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# ------------------------------------------------------------------------------
# 🗄️ DATABASE CONFIGURATION & ORM (PRISMA / POSTGRESQL)
# ------------------------------------------------------------------------------
# Main PostgreSQL connection string for Prisma query orchestration
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]&sslmode=[sslmode]
DATABASE_URL=

# Enterprise Connection Pool Settings (prevents DB exhaustion and manages throughput)
# Maximum number of concurrent connections Prisma client opens
DATABASE_MAX_POOL_SIZE=20

# Max time in seconds to wait for a free DB connection from the connection pool
DATABASE_CONNECTION_TIMEOUT=15

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION, CRYPTOGRAPHY & SECURITY (JWT & BCRYPT)
# ------------------------------------------------------------------------------
# Secret signature key for short-lived Access Tokens (symmetric HMAC-SHA256)
# [Enterprise Rule: In production, generate a strong random key via 'openssl rand -base64 32']
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# Secret signature key for long-lived Refresh Tokens
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Cryptographic salt calculation work factor for bcrypt (12 provides ideal security-to-speed balance)
BCRYPT_SALT_ROUNDS=12

# JWT Transport Cookie settings
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------------
# ⚡ REDIS CACHE SYSTEM
# ------------------------------------------------------------------------------
# Redis network connection URL endpoint
REDIS_URL=

# Redis server authorization password (leave empty if none)
REDIS_PASSWORD=

# Default Cache Time-To-Live (TTL) configuration (in seconds, 3600 = 1 hour)
REDIS_DEFAULT_TTL=3600

# ------------------------------------------------------------------------------
# 🛡️ TRAFFIC LIMITS & PERFORMANCE (RATE LIMIT & COMPRESSION)
# ------------------------------------------------------------------------------
# Rate limiting window time setting (in milliseconds, 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum allowed requests per client IP within the rate-limiting window
RATE_LIMIT_MAX=100

# Gzip HTTP Response Compression level [1-9] (6 provides the best CPU-to-shrinkage efficiency)
COMPRESSION_LEVEL=6

# ------------------------------------------------------------------------------
# 🌐 THIRD-PARTY API PROVIDERS & PROXIES (AXIOS SETTINGS)
# ------------------------------------------------------------------------------
# Maximum network request timeout in milliseconds for Axios queries to third-party endpoints
# (Enterprise Tip: Protects core API gateway threads from hanging during third-party outages)
EXTERNAL_API_TIMEOUT_MS=10000

# Target endpoints for anime news feeds and discovery systems
ANIME_NEWS_NETWORK_API_URL=https://cdn.animenewsnetwork.com/encyclopedia/api.xml
JIKAN_API_URL=https://api.jikan.moe/v4
ANILIST_API_URL=https://graphql.anilist.co

# ------------------------------------------------------------------------------
# 📊 LOGGING, PERFORMANCE AUDITS & ERROR TRACKING
# ------------------------------------------------------------------------------
# Master log level threshold [error | warn | info | http | debug]
LOG_LEVEL=info

# Standard output log formatter style [dev | combined | json]
# (json formatting is strongly recommended for production tools like Datadog, ELK, or CloudWatch)
LOG_FORMAT=dev

# Sentry Application Performance Monitoring (APM) & Error Tracing DSN endpoint
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
